# Local demo only. Copy to .env before `docker compose up`.
# Do not commit .env.
#
# The Airflow web user and password in docker-compose.yml are `airflow` / `airflow`.
# They are local-only demo credentials, including the Postgres role of the same name.
#
# Generate a Fernet key and set it here. docker-compose.yml reads AIRFLOW_FERNET_KEY
# into AIRFLOW__CORE__FERNET_KEY and does not ship a literal key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_UID=50000
